# --- Core ---------------------------------------------------------------
# Public base URL of the app (no trailing slash).
APP_URL=http://localhost:3000
# Domain written to NFC chips and QR codes. Must be PERMANENT in production:
# if it lapses or changes, every card ever sold stops working.
CARD_DOMAIN=http://localhost:3000

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nfc

# --- Auth ---------------------------------------------------------------
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# Secret used to HMAC card claim codes. Changing it invalidates unclaimed codes.
CLAIM_CODE_SECRET=replace-me-with-another-long-random-string

# --- Email --------------------------------------------------------------
# "console" (dev: logs + writes .mail-outbox/) or "resend"
EMAIL_PROVIDER=console
EMAIL_FROM="Tessera <hello@example.com>"
RESEND_API_KEY=

# --- Storage (Milestone 2) ---------------------------------------------
# "local" (dev: ./.uploads) or "s3"
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payments -----------------------------------------------------------
# "stripe" or "simulated". Defaults to stripe when STRIPE_SECRET_KEY is set,
# otherwise simulated (a local fake checkout; refused when APP_ENV=production).
PAYMENTS_PROVIDER=
# Test-mode keys start with sk_test_ / whsec_. See README "Stripe test mode".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Turn on only after configuring tax registrations in the Stripe dashboard.
STRIPE_TAX_ENABLED=false

# --- Enquiries ----------------------------------------------------------
# Where team enquiry notifications go (defaults to brand.supportEmail).
ENQUIRY_NOTIFY_EMAIL=

# --- Rate limiting -----------------------------------------------------
# Leave empty in development to use the in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Header carrying the real client IP. Leave empty on Vercel (handled automatically).
# Behind your own proxy, set it to the header that proxy sets (e.g. CF-Connecting-IP).
TRUSTED_IP_HEADER=

# --- Analytics (optional, off by default) -------------------------------
ANALYTICS_ENABLED=false
